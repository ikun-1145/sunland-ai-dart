{
	"$schema": "https://unpkg.com/wrangler/config-schema.json",
	"name": "ai",
	"main": "src/index.js",
	"compatibility_date": "2026-03-21",
	// 保留 Dashboard 中配置的环境变量（DEEPSEEK_KEY 等），部署时不清除
	"keep_vars": true,
	// 不启用 workers.dev 子域名，流量走自定义域名 api.sunland.dev
	"workers_dev": false,
	"routes": [
		{
			"pattern": "api.sunland.dev",
			"custom_domain": true
		}
	],
	"observability": {
		"enabled": true
	},
	"vars": {
		"ALLOWED_ORIGIN": "https://sunland.dev",
		"GEETEST_ID": "ad3a8126afe716ccd4541f35d428071e",
		"SUPABASE_PROJECT_URL": "https://klyrasrqgxijwrxuoevj.supabase.co"
	},
	"secrets": {
		"required": [
			"APP_JWT_PRIMARY_SECRET",
			"APP_JWT_LEGACY_SECRET",
			"DEEPSEEK_API_KEY",
			"GEETEST_SERVER_KEY",
			"RESEND_API_TOKEN",
			"SUPABASE_LEGACY_JWT_SECRET",
			"SUPABASE_SECRET_KEY"
		]
	},
	"kv_namespaces": [
		{ "binding": "CODE_STORE", "id": "29b10d1dd6a647b9bd0bccff5a48719f" },
		{ "binding": "USAGE_KV", "id": "29b10d1dd6a647b9bd0bccff5a48719f" }
	],
	"env": {
		"staging": {
			"name": "sunland-api-gateway-staging",
			"workers_dev": false,
			"routes": [
				{
					"pattern": "api-staging.sunland.dev",
					"custom_domain": true
				}
			],
			"vars": {
				"ACTIVATION_CLAIM_ENABLED": "false",
				"ALLOWED_ORIGIN": "https://sunland.dev",
				"GEETEST_ID": "ad3a8126afe716ccd4541f35d428071e",
				"SUPABASE_PROJECT_URL": "https://klyrasrqgxijwrxuoevj.supabase.co"
			},
			"secrets": {
				"required": [
					"APP_JWT_PRIMARY_SECRET",
					"APP_JWT_LEGACY_SECRET",
					"DEEPSEEK_API_KEY",
					"GEETEST_SERVER_KEY",
					"RESEND_API_TOKEN",
					"SUPABASE_LEGACY_JWT_SECRET",
					"SUPABASE_SECRET_KEY"
				]
			},
			"kv_namespaces": [
				{ "binding": "CODE_STORE", "id": "9599d92d600b4a19bf85fb29669cf4e2" },
				{ "binding": "USAGE_KV", "id": "04fdebf1c3d4482ab31d8f31008033be" }
			]
		}
	}
}
